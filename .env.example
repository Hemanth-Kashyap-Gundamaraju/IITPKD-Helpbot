# ============================================================================
# IITPKD Helpbot — Environment Variables
# Copy this file to .env and fill in the values.
# ============================================================================

# ---------------------------------------------------------------------------
# Required — the app will crash without these
# ---------------------------------------------------------------------------
PINECONE_API_KEY=your-pinecone-api-key-here

# ---------------------------------------------------------------------------
# LLM (Groq) — required for answering questions
# ---------------------------------------------------------------------------
GROQ_API_KEY=your-groq-api-key-here
LLM_MODEL_NAME=qwen/qwen3.6-27b
LLM_TEMPERATURE=0

# ---------------------------------------------------------------------------
# Embeddings — controls which embedding model is used
# ---------------------------------------------------------------------------
# APP_ENV=local        → uses HuggingFace (free, no quota)
# APP_ENV=production   → uses Google Gemini (quota-limited)
APP_ENV=local
LOCAL_EMBEDDING_MODEL_NAME=intfloat/e5-large-v2
# GOOGLE_API_KEY=your-google-api-key-here  # only needed if APP_ENV=production

# ---------------------------------------------------------------------------
# Pinecone vector DB
# ---------------------------------------------------------------------------
PINECONE_INDEX_NAME=iit-pkd-index
RETRIEVER_TOP_K=3

# ---------------------------------------------------------------------------
# Scraper settings (optional — sensible defaults exist)
# ---------------------------------------------------------------------------
# SCRAPER_BASE_URL=https://iitpkd.ac.in/
# SCRAPER_DISCOVERY_MAX_PAGES=25
# SCRAPER_TARGET_MAX_PAGES=100
# SCRAPER_REQUEST_TIMEOUT=10

# ---------------------------------------------------------------------------
# Ingestion batching (optional — controls rate-limit safety)
# ---------------------------------------------------------------------------
# INGESTION_BATCH_SIZE=10
# INGESTION_RATE_LIMIT_COOLDOWN=60
# INGESTION_BATCH_PAUSE=8

# ---------------------------------------------------------------------------
# WhatsApp Business API — required for WhatsApp interface
# ---------------------------------------------------------------------------
# WHATSAPP_TOKEN=your-meta-whatsapp-token
# WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
# WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
# WHATSAPP_GRAPH_API_VERSION=v18.0
